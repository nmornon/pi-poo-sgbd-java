@startuml
title SGBD - Modélisation

package "moteur" {
  class BaseDeDonnees {
    - identifiant: ChaineDeCaractere
    - prochainSerial : Entier
    - estOuvert : Boolean
  }

  class Table {
  }

  class Relation {
    - identifiant : ChaineDeCaractere 
  }

  enum Type {
    INT
    SERIAL
    VARCHAR
  }

  class Tuple {
  }

  class Colonne{
    - identifiant : ChaineDeCaractere
    - type : Type
  }
}

package "conditions"{
  class ExpressionLogique {
    - connecteurs : OperateurLogique[]
  }

  class ConditionSimple {
    - gauche : Operande
    - droite : Operande
    - operateur : Comparateur
  }

  abstract class Operande {
  }

  class OperandeColonne {
    - identifiant : ChaineDeCaractere 
  }

  class OperandeValeur {
    - valeur : Valeur 
  }

  enum OperateurLogique {
    AND
    OR
  }

  enum Comparateur {
    EGAL
    SUPERIEUR
    INFERIEUR
  }
}

package "valeur"{

  class Valeur {
   - type : Type
   - valeur : Object
   
  }

  class Entier {}

  class Cle {}

  class Chaine{}
}

Operande <|-- OperandeColonne
Operande <|-- OperandeValeur

Valeur <|-- Entier 
Valeur <|-- Cle 
Valeur <|-- Chaine

BaseDeDonnees "1" *-- "*" Table
Relation <|-- Table
Relation *-- Tuple
Relation "1" *-- "*" Colonne

ExpressionLogique "1" *-- "*" ConditionSimple
ExpressionLogique --> OperateurLogique

ConditionSimple --> Operande
ConditionSimple --> Comparateur
OperandeColonne --> Colonne
Tuple "1" *-- "*"  Valeur
Valeur -->Type
Valeur -->OperandeValeur
@enduml

