@startuml
title SGBD - Conception

package application {
  class Main {
    + {static} main(args : String[])
  }
}

package persistance {
  class GestionnairePersistance {
    + charger(): BaseDeDonnees
    + sauvegarder(BaseDeDonnees)
  }
}

package interpreteur {
  class Interpreteur {
    + interpreter(String): Commande
  }
}

package exception {

  class ColonneDejaExistantException{}
  class ColonneException{}
  class ColonneInexistantException{}
  class SGBDException {}
  class ProduitCartesienException{}
  class RelationException{}
  class RelationSansColonneException{}
  class SelectionException{}
  class TableDejaExistanteException{}
  class TableException{}
  class TableInexistanteException{}
  class TypeInvalideException{}

}

package moteur {
  class BaseDeDonnees {
    - identifiant: String
    - nbLignes: Long
    - estOuvert : Boolean
    - tables : Collection<Table>
    + getEstOuverte() : Boolean
    + setEstOuverte(bool : Boolean)
    + getIdentifiant() : String
    + getNbLignes() : Long
    + getTables() : Collection<Table>
    + creerTable(identifiant : String, donnees : Collection<Attribut>): Table
    + creerTable(identifiant : String, tuples : Collection<Tuple>): Table
    + supprimerTable(id : String)
    + toString () : String
  }

  class Table {
    - identifiant : String
    + inserer(Tuple)
    + inserer(Tuple[])
    + supprimer(ExpressionLogique)
  }

  class Relation {
    - identifiant : String
    - tuples: Collection<Tuple>
    - attributs: Set<Attribut>
    + getIdentifiant() : String
    + hasAttribut(identifiant : String) : Boolean
    + getAttribut(String identifiant) : Attribut
    + getAttributs() : Collection<Attribut>
    + getTuples() : Collection<Tuple>
    + selectionner(attributs : Collection<Attribut>): Relation
    + projeter(ExpressionLogique): Relation
    + joindre(Relation, Attribut, Attribut): Relation
    + produitCartesien(Relation): Relation
  }

  enum Type {
    INT
    SERIAL
    VARCHAR
  }

  record Attribut {
    - identifiant: String
    - type: Type
  }

  class Tuple {
    - valeurs: HashMap<String, Valeur>
    + Tuple()
    + hasIdentifiant() : Identifiant
    + getValeur(Identifiant): Valeur
    + getValeurs(): Valeur[]
    + set(Identifiant, Valeur): Tuple
  }

  class Valeur {
    + getValeur(): Object
    + getType(): Type
    + equals(valeur : Object) : Boolean
    
  }

  class Cle {
    - valeur: Number
    - type: Type
    + Cle(Number)
  }

  class Chaine {
    - valeur: String
    - type: Type
    + Chaine(String)
  }

  class Nombre {
    - valeur: Number
    - type: Type
    + Nombre(Number)
  }
}

package conditions {

  class ExpressionLogique {
    - conditions : List<ConditionSimple>
    - connecteurs : List<OperateurLogique>
    
    + ExpressionLogique()
    + ajouterCondition(condition : ConditionSimple) : void 
    + ajouterConnecteur(connecteur : OperateurLogique) : void 
    + evaluer(tuple : Tuple) : boolean
  }

  class ConditionSimple {
    - gauche : Operande
    - droite : Operande
    - comparateur : Comparateur

    + evaluer(contexte : Map<String, Tuple>) : boolean
  }

  abstract Operande {
    + {abstract} evaluer(contexte : Map<String, Tuple>) : Valeur
  }

  class OperandeAttribut {
    - nomTableOuAlias : String
    - nomAttribut : String
    + evaluer(contexte : Map<String, Tuple>) : Valeur
  }

  class OperandeValeur {
    - contenu : Object
    + evaluer(contexte : Map<String, Tuple>) : Valeur
  }

  enum OperateurLogique {
    AND
    OR
  }

  enum Comparateur {
    EGAL
    SUPERIEUR
    INFERIEUR
  }
}

Operande <|-- OperandeAttribut
Operande <|-- OperandeValeur

Main --> GestionnairePersistance
Main --> Interpreteur

GestionnairePersistance --> BaseDeDonnees

BaseDeDonnees "1" *-- "*" Table
Relation <|-- Table
Relation "1"  o-- "*" Tuple
Relation "1" *-- "*" Attribut

Attribut *-- Valeur

Valeur <|-- Cle
Valeur <|-- Chaine
Valeur <|-- Nombre

ColonneException <|-- ColonneDejaExistantException
ColonneException <|-- ColonneInexistantException 
RelationException <|-- ProduitCartesienException
RelationException <|-- RelationSansColonneException
RelationException <|-- SelectionException
TableException <|-- TableDejaExistanteException
SGBDException <|-- TableException
TableException <|-- TableInexistanteException
SGBDException <|-- TypeInvalideException 
SGBDException <|-- ColonneException
SGBDException <|-- RelationException





ExpressionLogique "1" *-- "*" ConditionSimple
ExpressionLogique --> OperateurLogique

ConditionSimple --> Operande
ConditionSimple --> Comparateur
@enduml