@startuml
title SGBD - Conception


package sgbd {
class Main {
    + {static} main(args : String[])
    - {static} initialiserInterpreteur(String commande)
    - {static} figlet(String cmdline)
}

package persistance {
  class GestionnairePersistance {
    + GestionnairePersistance()
    + charger(String nomFichier): BaseDeDonnees
    + sauvegarder(BaseDeDonnees)
  }
}

package analyseurs {
  class Interpreteur {
    + commande(bdd : BaseDeDonnees) : void
  }
}

package exception {

  class ColonneDejaExistantException{}
  class ColonneException{}
  class ColonneInexistanteException{}
  class InsertionException{}
  class SGBDException {}
  class ProduitCartesienException{}
  class RelationException{}
  class RelationSansColonneException{}
  class SelectionException{}
  class TableDejaExistanteException{}
  class TableException{}
  class TableInexistanteException{}
  class TypeInvalideException{}

}

package moteur {
  class BaseDeDonnees {
    - identifiant: String
    - prochainSerial : int
    - estOuvert : Boolean
    - tables : Collection<Table>
    + BaseDeDonnees (String identifiant)
    + BaseDeDonnees(String identifiant, int dernierSerial)
    + BaseDeDonnees(String identifiant, Collection<Table> tables)
    + BaseDeDonnees(String identifiant, Collection<Table> tables, int dernierSerial)
    + getEstOuverte() : Boolean
    + setEstOuverte(bool : Boolean)
    + getIdentifiant() : String
    + getProchaineCle() : Cle
    + getTables() : Collection<Table>
    + hasTable(String identifiant) : Boolean
    + getTable(String identifiant) : Table
    + creerTable(String identifiant, Collection<Colonne> donnees): Table
    + creerTable(String identifiant, Collection<Colonne> donnees, Collection<Tuple> tuples): Table
    + supprimerTable(String identifiant)
    + toString () : String
    + equals(Object object) : Boolean
  }

  class Table {
    - baseDeDonnees : BaseDeDonnees 
    + Table( BaseDeDonnees baseDeDonnees, String identifiant,Collection<Colonne> colonnes)
    + Table( BaseDeDonnees baseDeDonnees, String identifiant,Collection<Colonne> colonnes,Collection<Tuple> tuples)
    + inserer(Tuple tuple)
    + supprimer() : int
    + supprimer(ExpressionLogique condition) : int
  }

  class Relation {
    - identifiant : String
    - tuples: Collection<Tuple>
    - colonnes: Set<Colonne>
    + Relation(String identifiant, Collection<Colonne> colonnes)
    + Relation(String identifiant, Collection<Colonne> colonnes, Collection<Tuple> tuples)
    + getIdentifiant() : String
    + hasColonne(String identifiant) : Boolean
    + getColonne(String identifiant) : Colonne
    + getColonnes() : Collection<Colonne>
    + getTuples() : Collection<Tuple>
    # verifierTuple(Tuple tuple)
    + alias(String alias) : Relation
    + selectionner(Set<String> colonnes): Relation
    + projeter(ExpressionLogique expression): Relation
    + produitCartesien(Relation relation): Relation
    - concatenerColonnes(String identifiant1, Collection<Colonne> colonnes1, String identifiant2, Collection<Colonne> colonnes2) : Collection<Colonne>
    + toString() : String
    - concatenerIdentifiants(String identifiant1, String identifiant2): String
    + equals(Object object) : boolean
  }

  enum Type {
    INT
    SERIAL
    VARCHAR
  }

  record Colonne {
    - identifiant: String
    - type: Type
    + prefixer(String prefix) : Colonne
    + equals(Object object) : Boolean
  }

  class Tuple {
    - valeurs: Map<String, Valeur>
    + Tuple()
    + hasIdentifiant(String identifiant) : Boolean
    + getValeur(String Identifiant): Valeur
    + getValeurs(): Map<String, Valeur> 
    + setValeur(String identifiant, Valeur valeur) : Tuple
    + prefixer(String prefix):Tuple
    + concatener(Tuple tuple) :Tuple
    + toString() : String
    + equals(Object object) : boolean
  }

   abstract class Valeur {
    - type : Type
    - valeur : Object
    + getValeur(): Object
    + getType(): Type
    + equals(valeur : Object) : Boolean
    + toString() : String
    
  }

  class Cle {
    + Cle( int valeur)
    + compareTo(Valeur valeur) : int
  }

  class Chaine {
    + Chaine(String valeur)
    + compareTo(Valeur valeur) : int
  }

  class Entier {
    + Entier(int valeur)
    + compareTo(Valeur valeur) : int
  }
}

package conditions {

  class ExpressionLogique {
    - conditions : List<ConditionSimple>
    - connecteurs : List<OperateurLogique>
    
    + ExpressionLogique()
    + ajouterCondition(ConditionSimple condition) : void 
    + ajouterConnecteur(OperateurLogique connecteur) : void 
    + evaluer(Tuple tuple) : boolean
  }

  class ConditionSimple {
    - gauche : Operande
    - droite : Operande
    - comparateur : Comparateur
    + ConditionSimple(Operande gauche, Operande droite, Comparateur comparateur) 
    + evaluer(Tuple tuple) : boolean
  }

  abstract Operande {
    + {abstract} evaluer(Tuple tuple) : Valeur
  }

  class OperandeColonne {
    - identifiant : String
    + OperandeColonne(String prefix, String attribut)
    + OperandeColonne(String identifiant)
    + evaluer(Tuple tuple) : Valeur
  }

  class OperandeValeur {
    - valeur : Valeur
    + OperandeValeur(Valeur valeur)
    + evaluer(Tuple tuple) : Valeur
  }

  enum OperateurLogique {
    AND
    OR
  }

  enum Comparateur {
    EGAL
    SUPERIEUR
    INFERIEUR
  }
}

}

Operande <|-- OperandeColonne
Operande <|-- OperandeValeur

Main --> GestionnairePersistance
Main --> Interpreteur

GestionnairePersistance --> BaseDeDonnees

BaseDeDonnees "1" *-- "*" Table
Relation <|-- Table


Valeur <|-- Cle
Valeur <|-- Chaine
Valeur <|-- Entier

ColonneException <|-- ColonneDejaExistantException
ColonneException <|-- ColonneInexistanteException 
RelationException <|-- ProduitCartesienException
RelationException <|-- RelationSansColonneException
RelationException <|-- SelectionException
TableException <|-- TableDejaExistanteException
SGBDException <|-- TableException
TableException <|-- TableInexistanteException
SGBDException <|-- TypeInvalideException 
SGBDException <|-- ColonneException
SGBDException <|-- RelationException
TableException <|-- InsertionException

Valeur -->Type
Relation "1" *-- "*" Tuple
Tuple "1" *-- "*"  Valeur
Relation "1" *-- "*" Colonne
ExpressionLogique "1" *-- "*" ConditionSimple
ExpressionLogique --> OperateurLogique

ConditionSimple --> Operande
ConditionSimple --> Comparateur
@enduml
