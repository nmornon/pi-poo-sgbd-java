options {
  LOOKAHEAD = 1;
  CHOICE_AMBIGUITY_CHECK = 1;
  OTHER_AMBIGUITY_CHECK = 1;
  STATIC = false;
  DEBUG_PARSER = false;
  DEBUG_LOOKAHEAD = false;
  DEBUG_TOKEN_MANAGER = false;
  ERROR_REPORTING = true;
  JAVA_UNICODE_ESCAPE = false;
  UNICODE_INPUT = false;
  IGNORE_CASE = true;
  USER_TOKEN_MANAGER = false;
  USER_CHAR_STREAM = false;
  BUILD_PARSER = true;
  BUILD_TOKEN_MANAGER = true;
  SANITY_CHECK = true;
  FORCE_LA_CHECK = true;
}

PARSER_BEGIN(Interpreteur)
package fr.insarouen.iti.compilation.sgbd.analyseurs;

import fr.insarouen.iti.compilation.sgbd.moteur.Colonne;
import fr.insarouen.iti.compilation.sgbd.moteur.BaseDeDonnees;
import fr.insarouen.iti.compilation.sgbd.moteur.Relation;
import fr.insarouen.iti.compilation.sgbd.moteur.Tuple;
import fr.insarouen.iti.compilation.sgbd.moteur.Type;
import fr.insarouen.iti.compilation.sgbd.moteur.valeur.Valeur;
import fr.insarouen.iti.compilation.sgbd.moteur.valeur.Chaine;
import fr.insarouen.iti.compilation.sgbd.moteur.valeur.Entier;

import fr.insarouen.iti.compilation.sgbd.conditions.Comparateur;
import fr.insarouen.iti.compilation.sgbd.conditions.ConditionSimple;
import fr.insarouen.iti.compilation.sgbd.conditions.ExpressionLogique;
import fr.insarouen.iti.compilation.sgbd.conditions.Operande;
import fr.insarouen.iti.compilation.sgbd.conditions.OperandeColonne;
import fr.insarouen.iti.compilation.sgbd.conditions.OperandeValeur;
import fr.insarouen.iti.compilation.sgbd.conditions.OperateurLogique;

import java.util.Collection;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;


public class Interpreteur {
    private BaseDeDonnees bdd;

    public void setBdd(BaseDeDonnees base){
        this.bdd = base;
    }
    public BaseDeDonnees getBdd(){
        return this.bdd;
    }
}

PARSER_END(Interpreteur)

SKIP: {
      " " 
    | "\t" 
    | "\r"
    | "\n"
}

TOKEN:{
    <CREATE: "CREATE">
  | <TABLE: "TABLE">
  | <INSERT: "INSERT">
  | <INTO: "INTO">
  | <VALUES: "VALUES">
  | <SELECT: "SELECT">
  | <FROM: "FROM">
  | <WHERE: "WHERE">
  | <DELETE: "DELETE">
  | <DROP: "DROP">
  | <TABLES: "TABLES">
  | <EXIT: "EXIT">
  | <QUIT: "QUIT">
  | <AS: "AS">
  | <AND: "AND">
  | <OR: "OR">
  | <INT: "INT">
  | <SERIAL: "SERIAL">
  | <VARCHAR: "VARCHAR">
  | <EGAL: "=">
  | <SUPERIEUR: ">">
  | <INFERIEUR: "<">
  | <VIRGULE: ",">
  | <POINTVIRGULE: ";">
  | <ETOILE: "*">
  | <PARENTHESE_OUVRANTE: "(">
  | <PARENTHESE_FERMANTE: ")">
  | <NUMBER: (["0"-"9"])+ >
  | <ID:["A"-"Z","a"-"z","_"](["A"-"Z","a"-"z","_",".","0"-"9"])*> 
  | <STRING: "\""(~["\""])*"\"">
  | <COMMENTAIRE: "--">
  | <SINGLE_LINE_COMMENT: "--" (~["\n","\r"])* ("\n"|"\r"|"\r\n")>
}

void commande():
{}
{
    (
          <SINGLE_LINE_COMMENT>
        | (
              commandeCreate()
            | commandeInsert()
            | commandeSelect()
            | commandeDelete()
            | commandeDrop()
            | commandeTables()
            | commandeExit()
        ) <POINTVIRGULE> 
    )*
    <EOF>
}

void commandeCreate():
{
    Collection<Colonne> listeColonnes = new ArrayList<Colonne>();
    Colonne colonne;
    String table;
}
{
    <CREATE> <TABLE> table = identifiant() <PARENTHESE_OUVRANTE>
    colonne = colonne() {listeColonnes.add(colonne);}
    (
        <VIRGULE> colonne = colonne() {listeColonnes.add(colonne);}
    )*
    <PARENTHESE_FERMANTE>

    {
        this.getBdd().creerTable(table, listeColonnes);
        System.out.printf("Table %s créée.\n", table);
    }
}

void commandeDrop():
{
    String table;
}
{
    <DROP> <TABLE> table = identifiant()
    {
        this.getBdd().supprimerTable(table);
        System.out.printf("Table %s supprimée.\n", table);
    }
}

void commandeInsert():
{
    String table, colonne;
    List<String> listeId = new ArrayList<String>();
    List<Valeur> listeVal = new ArrayList<Valeur>();
    Valeur val;
    Tuple tuple = new Tuple();
}
{
    <INSERT> <INTO> table = identifiant()

    <PARENTHESE_OUVRANTE>
    colonne = identifiant() {listeId.add(colonne);}
    (
        <VIRGULE> colonne = identifiant() {listeId.add(colonne);}
    )*
    <PARENTHESE_FERMANTE>

    <VALUES> <PARENTHESE_OUVRANTE> val = valeur() {listeVal.add(val);}
    (
        <VIRGULE> val = valeur() {listeVal.add(val);}
    )*
    <PARENTHESE_FERMANTE>

    {
        for(int i=0; i<listeId.size(); i++){
            tuple.setValeur(listeId.get(i), listeVal.get(i));
        }
        this.getBdd().getTable(table).inserer(tuple);
        System.out.printf("1 ligne insérée dans la table %s.\n", table);
    }
}

void commandeDelete():
{
    String table;
    ExpressionLogique exp = null;
    boolean hasWhere = false;
}
{
    <DELETE> <FROM> table = identifiant()
    (
        <WHERE> exp = expressionLogique() {hasWhere = true;}
    )?

    {
        int nbLignesSupprimees;
        if (hasWhere){
            nbLignesSupprimees = this.getBdd().getTable(table).supprimer(exp);
        }
        else {
            //methode supprimer(sans param) permet de supprimer tous les tuples
            nbLignesSupprimees = this.getBdd().getTable(table).supprimer();
        }
        System.out.printf("%d ligne(s) supprimée(s) dans la table %s.\n", nbLignesSupprimees, table);
    }
}

//1. Récupérer la liste des noms des colonnes dans listeIdAvecAlias
//2. Modifier cette liste pour avoir uniquement les noms des colonnes sans les alias
//3. Transformer cette liste en liste d'colonnes pour pouvoir appeler la méthode selectionner
void commandeSelect():
{
    Token t_select;
    Set<String> colonnes = new HashSet<String>();
    Relation relation, source;
    ExpressionLogique exp = null;
    boolean hasEtoile = false;
    boolean hasWhere = false;
}
{
    <SELECT> 
    (
        <ETOILE> { hasEtoile = true; }
        | t_select = <ID> {colonnes.add(t_select.image);}
        (
            <VIRGULE> t_select = <ID> {colonnes.add(t_select.image);}
        )*
    )

    <FROM> relation = source() 
    (
        <VIRGULE> source = source() {relation = relation.produitCartesien(source);}
    )*

    (
        <WHERE> exp = expressionLogique() { hasWhere = true; }
    )?

    {
        if (hasWhere){
            relation = relation.projeter(exp);
        }
        if (!hasEtoile){
            relation = relation.selectionner(colonnes);
        }
        System.out.println(relation);
    }
}

Relation source():
{
    String identifiant, alias;
}
{
    identifiant = identifiant()
    (
        (<AS>)?
        alias = identifiant() { return this.getBdd().getTable(identifiant).alias(alias); }
    )?
    {
        return this.getBdd().getTable(identifiant);
    }
}

String identifiant():
{
    Token identifiant;
}
{
    identifiant = <ID> {
        return identifiant.image;
    }
}

void commandeTables():
{}
{
    <TABLES> 
    {
        System.out.println(this.getBdd());
    }
}

void commandeExit():
{}
{
    ( 
      <EXIT> | <QUIT>
    )
    {
        this.getBdd().setEstOuverte(false);
        System.out.println("Au revoir !");
    }
}


Colonne colonne():
{
    Type type;
    Token t;
}
{
    t = <ID> type = type()
    {return new Colonne(t.image,type);}
}

Type type():
{
    Token t;
}
{
    t = <INT> {return Type.INT;}
    | t = <VARCHAR> {return Type.VARCHAR;}
    | t = <SERIAL> {return Type.SERIAL;}
}

Valeur valeur():
{
    Token t;
}
{
    t = <NUMBER> {return new Entier(Integer.valueOf(t.image));}
    | t = <STRING> {return new Chaine(t.image);}
}

ExpressionLogique expressionLogique():
{
    ConditionSimple conditionSimple;
    ExpressionLogique exp = new ExpressionLogique();
}
{
    conditionSimple = conditionSimple() {exp.ajouterCondition(conditionSimple);}
    (
        (
            <AND> {exp.ajouterConnecteur(OperateurLogique.AND);}
          | <OR> {exp.ajouterConnecteur(OperateurLogique.OR);}
        )
        conditionSimple = conditionSimple() {exp.ajouterCondition(conditionSimple);}
    )*
    {
        return exp;
    }
}

ConditionSimple conditionSimple():
{
    String colonne1, colonne2;
    Comparateur comparateur;
    Operande opG, opD;
    Valeur valeur;
}
{
    colonne1 = identifiant() {opG = new OperandeColonne(colonne1);}
    (
      <EGAL>      {comparateur = Comparateur.EGAL;}
    | <SUPERIEUR> {comparateur = Comparateur.SUPERIEUR;}
    | <INFERIEUR> {comparateur = Comparateur.INFERIEUR;}
    )
    (
        valeur = valeur() {opD = new OperandeValeur(valeur);}
      | colonne2 = identifiant() {opD = new OperandeColonne(colonne2);}
    )
    {
        return new ConditionSimple(opG, opD, comparateur);
    }
}
