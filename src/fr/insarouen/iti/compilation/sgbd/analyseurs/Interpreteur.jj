options {
  LOOKAHEAD = 1;
  CHOICE_AMBIGUITY_CHECK = 1;
  OTHER_AMBIGUITY_CHECK = 1;
  STATIC = false;
  DEBUG_PARSER = false;
  DEBUG_LOOKAHEAD = false;
  DEBUG_TOKEN_MANAGER = false;
  ERROR_REPORTING = true;
  JAVA_UNICODE_ESCAPE = false;
  UNICODE_INPUT = false;
  IGNORE_CASE = true;
  USER_TOKEN_MANAGER = false;
  USER_CHAR_STREAM = false;
  BUILD_PARSER = true;
  BUILD_TOKEN_MANAGER = true;
  SANITY_CHECK = true;
  FORCE_LA_CHECK = true;
}

PARSER_BEGIN(Interpreteur)
package fr.insarouen.iti.compilation.sgbd.analyseurs;

import fr.insarouen.iti.compilation.sgbd.moteur.Colonne;
import fr.insarouen.iti.compilation.sgbd.moteur.BaseDeDonnees;
import fr.insarouen.iti.compilation.sgbd.moteur.Relation;
import fr.insarouen.iti.compilation.sgbd.moteur.Tuple;
import fr.insarouen.iti.compilation.sgbd.moteur.Type;
import fr.insarouen.iti.compilation.sgbd.moteur.valeur.Valeur;
import fr.insarouen.iti.compilation.sgbd.moteur.valeur.Chaine;
import fr.insarouen.iti.compilation.sgbd.moteur.valeur.Entier;

import fr.insarouen.iti.compilation.sgbd.conditions.Comparateur;
import fr.insarouen.iti.compilation.sgbd.conditions.ConditionSimple;
import fr.insarouen.iti.compilation.sgbd.conditions.ExpressionLogique;
import fr.insarouen.iti.compilation.sgbd.conditions.Operande;
import fr.insarouen.iti.compilation.sgbd.conditions.OperandeColonne;
import fr.insarouen.iti.compilation.sgbd.conditions.OperandeValeur;
import fr.insarouen.iti.compilation.sgbd.conditions.OperateurLogique;

import java.util.Collection;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;


public class Interpreteur {
    private BaseDeDonnees bdd;

    public void setBdd(BaseDeDonnees base){
        this.bdd = base;
    }
    public BaseDeDonnees getBdd(){
        return this.bdd;
    }
}

PARSER_END(Interpreteur)

SKIP: {
      " " 
    | "\t" 
    | "\r"
    | "\n"
}

TOKEN:{
    <CREATE: "CREATE">
  | <TABLE: "TABLE">
  | <INSERT: "INSERT">
  | <INTO: "INTO">
  | <VALUES: "VALUES">
  | <SELECT: "SELECT">
  | <FROM: "FROM">
  | <WHERE: "WHERE">
  | <DELETE: "DELETE">
  | <DROP: "DROP">
  | <TABLES: "TABLES">
  | <EXIT: "EXIT">
  | <QUIT: "QUIT">
  | <AS: "AS">
  | <AND: "AND">
  | <OR: "OR">
  | <INT: "INT">
  | <SERIAL: "SERIAL">
  | <VARCHAR: "VARCHAR">
  | <EGAL: "=">
  | <SUPERIEUR: ">">
  | <INFERIEUR: "<">
  | <VIRGULE: ",">
  | <POINTVIRGULE: ";">
  | <ETOILE: "*">
  | <PARENTHESE_OUVRANTE: "(">
  | <PARENTHESE_FERMANTE: ")">
  | <NUMBER: (["0"-"9"])+ >
  | <ID:["A"-"Z","a"-"z","_"](["A"-"Z","a"-"z","_",".","0"-"9"])*> 
  | <STRING: "\""(~["\""])*"\"">
  | <COMMENTAIRE: "--" (~["\n","\r"])* ("\n"|"\r"|"\r\n")>
}

void commande():
{}
{
    (
          <COMMENTAIRE>
        | (
              commandeCreate()
            | commandeInsert()
            | commandeSelect()
            | commandeDelete()
            | commandeDrop()
            | commandeTables()
            | commandeExit()
        ) <POINTVIRGULE> 
    )*
    <EOF>
}

void commandeCreate():
{
    Collection<Colonne> colonnes = new ArrayList<Colonne>();
    Colonne colonne;
    String table;
}
{
    <CREATE> <TABLE> table = identifiant() <PARENTHESE_OUVRANTE>
    colonne = colonne() { colonnes.add(colonne); }
    (
        <VIRGULE> colonne = colonne() { colonnes.add(colonne); }
    )*
    <PARENTHESE_FERMANTE>
    {
        this.getBdd().creerTable(table, colonnes);
        System.out.printf("Table %s créée.\n", table);
    }
}

void commandeDrop():
{
    String table;
}
{
    <DROP> <TABLE> table = identifiant()
    {
        this.getBdd().supprimerTable(table);
        System.out.printf("Table %s supprimée.\n", table);
    }
}

void commandeInsert():
{
    String table, colonne;
    List<String> colonnes = new ArrayList<String>();
    List<Valeur> valeurs = new ArrayList<Valeur>();
    Valeur valeur;
    Tuple tuple = new Tuple();
}
{
    <INSERT> <INTO> table = identifiant() <PARENTHESE_OUVRANTE>
    colonne = identifiant() { colonnes.add(colonne); }
    (
        <VIRGULE> colonne = identifiant() { colonnes.add(colonne); }
    )* <PARENTHESE_FERMANTE>
    <VALUES> <PARENTHESE_OUVRANTE> valeur = valeur() { valeurs.add(valeur); }
    (
        <VIRGULE> valeur = valeur() { valeurs.add(valeur); }
    )*
    <PARENTHESE_FERMANTE>

    {
        for (int i = 0; i < colonnes.size(); i++){
            tuple.setValeur(colonnes.get(i), valeurs.get(i));
        }
        this.getBdd().getTable(table).inserer(tuple);
        System.out.printf("1 ligne insérée dans la table %s.\n", table);
    }
}

void commandeDelete():
{
    String table;
    ExpressionLogique expression = null;
    boolean hasWhere = false;
}
{
    <DELETE> <FROM> table = identifiant()
    (
        <WHERE> expression = expressionLogique() { hasWhere = true; }
    )?
    {
        int nbLignesSupprimees;

        if (hasWhere){
            nbLignesSupprimees = this.getBdd().getTable(table).supprimer(expression);
        } else {
            nbLignesSupprimees = this.getBdd().getTable(table).supprimer();
        }
        System.out.printf("%d ligne(s) supprimée(s) dans la table %s.\n", nbLignesSupprimees, table);
    }
}

void commandeSelect():
{
    String table;
    Set<String> colonnes = new HashSet<String>();
    Relation relation, source;
    ExpressionLogique expression = null;
    boolean hasEtoile = false;
    boolean hasWhere = false;
}
{
    <SELECT> (
          <ETOILE> { hasEtoile = true; }
        | table = identifiant() { colonnes.add(table); }
        (
            <VIRGULE> table = identifiant() { colonnes.add(table); }
        )*
    )
    <FROM> relation = source() 
    (
        <VIRGULE> source = source() {relation = relation.produitCartesien(source);}
    )*
    (
        <WHERE> expression = expressionLogique() { hasWhere = true; }
    )?
    {
        if (hasWhere){
            relation = relation.projeter(expression);
        }
        if (!hasEtoile){
            relation = relation.selectionner(colonnes);
        }
        System.out.println(relation);
    }
}

void commandeTables():
{}
{
    <TABLES> 
    {
        System.out.println(this.getBdd());
    }
}

void commandeExit():
{}
{
    ( 
      <EXIT> | <QUIT>
    )
    {
        this.getBdd().setEstOuverte(false);
        System.out.println("Au revoir !");
    }
}

ExpressionLogique expressionLogique():
{
    ConditionSimple conditionSimple;
    ExpressionLogique expression = new ExpressionLogique();
}
{
    conditionSimple = conditionSimple() { expression.ajouterCondition(conditionSimple); }
    (
        (
            <AND> { expression.ajouterConnecteur(OperateurLogique.AND); }
          | <OR>  { expression.ajouterConnecteur(OperateurLogique.OR); }
        )
        conditionSimple = conditionSimple() { expression.ajouterCondition(conditionSimple); }
    )*
    {
        return expression;
    }
}

ConditionSimple conditionSimple():
{
    String colonne;
    Comparateur comparateur;
    Operande operandeGauche, operandeDroit;
    Valeur valeur;
}
{
    colonne = identifiant() { operandeGauche = new OperandeColonne(colonne); }
    (
          <EGAL>      { comparateur = Comparateur.EGAL; }
        | <SUPERIEUR> { comparateur = Comparateur.SUPERIEUR; }
        | <INFERIEUR> { comparateur = Comparateur.INFERIEUR; }
    )
    (
          valeur = valeur()       { operandeDroit = new OperandeValeur(valeur); }
        | colonne = identifiant() { operandeDroit = new OperandeColonne(colonne); }
    )
    {
        return new ConditionSimple(operandeGauche, operandeDroit, comparateur);
    }
}

Relation source():
{
    String identifiant, alias;
}
{
    identifiant = identifiant()
    (
        (<AS>)?
        alias = identifiant() { return this.getBdd().getTable(identifiant).alias(alias); }
    )?
    {
        return this.getBdd().getTable(identifiant);
    }
}

Colonne colonne():
{
    String identifiant;
    Type type;
}
{
    identifiant = identifiant() type = type()
    {
        return new Colonne(identifiant, type);
    }
}

String identifiant():
{
    Token identifiant;
}
{
    identifiant = <ID> {
        return identifiant.image;
    }
}

Valeur valeur():
{
    Token token;
}
{
      token = <NUMBER> { return new Entier(Integer.valueOf(token.image)); }
    | token = <STRING> { return new Chaine(token.image.substring(1, token.image.length() - 1)); }
}

Type type():
{}
{
      <INT>     { return Type.INT; }
    | <VARCHAR> { return Type.VARCHAR; }
    | <SERIAL>  { return Type.SERIAL; }
}
