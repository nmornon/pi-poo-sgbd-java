// j'ai copié collé ceux du basic 

options {
  LOOKAHEAD = 1;
  CHOICE_AMBIGUITY_CHECK = 1;
  OTHER_AMBIGUITY_CHECK = 1;
  STATIC = false;
  DEBUG_PARSER = false;
  DEBUG_LOOKAHEAD = false;
  DEBUG_TOKEN_MANAGER = false;
  ERROR_REPORTING = true;
  JAVA_UNICODE_ESCAPE = false;
  UNICODE_INPUT = false;
  IGNORE_CASE = false;
  USER_TOKEN_MANAGER = false;
  USER_CHAR_STREAM = false;
  BUILD_PARSER = true;
  BUILD_TOKEN_MANAGER = true;
  SANITY_CHECK = true;
  FORCE_LA_CHECK = true;
}

PARSER_BEGIN(AnalyseurSyntaxique)
package fr.insarouen.iti.compilation.sgbd.analyseurs;

import fr.insarouen.iti.compilation.sgbd.commandes.*;
import fr.insarouen.iti.compilation.sgbd.moteur.*;
import fr.insarouen.iti.compilation.sgbd.conditions.*;


public class AnalyseurSyntaxique{
    private BaseDeDonnees bdd;

    public void setBdd(BaseDeDonnees base){
        this.bdd = base;
    }
    public BaseDeDonnees getBdd(){
        return this.bdd;
    }
}

PARSER_END(AnalyseurSyntaxique)

SKIP: {
      " " 
    | "\t" 
    | "\r"
    | "\n"
}

TOKEN:{
    <CREATE: "CREATE">
  | <TABLE: "TABLE">
  | <INSERT: "INSERT">
  | <INTO: "INTO">
  | <VALUES: "VALUES">
  | <SELECT: "SELECT">
  | <FROM: "FROM">
  | <WHERE: "WHERE">
  | <DELETE: "DELETE">
  | <DROP: "DROP">
  | <TABLES: "TABLES">
  | <EXIT: "EXIT">
  | <QUIT: "QUIT">
  | <AS: "AS">
  | <AND: "AND">
  | <OR: "OR">
  | <INT: "INT">
  | <SERIAL: "SERIAL">
  | <VARCHAR: "VARCHAR">
  | <EGAL: "=">
  | <SUPERIEUR: ">">
  | <INFERIEUR: "<">
  | <VIRGULE: ",">
  | <POINTVIRGULE: ";">
  | <ETOILE: "*">
  | <PARENTHESE_OUVRANTE: "(">
  | <PARENTHESE_FERMANTE: ")">
  | <NUMBER: (["0"-"9"])+ >
  | <ID:["A"-"Z","a"-"z","_"](["A"-"Z","a"-"z","_",".","0"-"9"])*> 
  | <STRING: "\""(~["\""])*"\"">
}

//Pour l'instant on oublie cette méthode
void commande():
{}
{
    (
        commandeCreate()
      | commandeInsert()
      | commandeSelect()
      | commandeDelete()
      | commandeDrop()
      | commandeTables()
      | commandeExit()
    )

    <POINTVIRGULE>
}

void commandeCreate():
{
    Collection<Colonne> listeColonnes = new ArrayList<Colonne>();
    Colonne attr,attr2;
    Token t;
}
{
    <CREATE> <TABLE> t = <ID> <PARENTHESE_OUVRANTE>
    attr = colonne() {listeColonnes.add(attr);}
    (<VIRGULE> attr2 = colonne() {listeColonnes.add(attr2);})*
    <PARENTHESE_FERMANTE>
    <POINTVIRGULE>

    {
        //Il faut récupérer la base de données à aquelle on applique la commande
        this.getBdd().createTable(t.image, listeColonnes);
    }
}

void commandeDrop():
{
    Token t;
}
{
    <DROP> <TABLE> t = <ID>
    <POINTVIRGULE>
    {this.getBdd().dropTable(t.image);}
}

void commandeInsert():
{
    Token id_table, id_attr, id_attr2;
    Collection<String> listeId = new ArrayList<String>();
    Collection<Valeur> listeVal = new ArrayList<Valeur>();
    Valeur val;
    Tuple tuple = new Tuple();
}
{
    <INSERT> <INTO> id_table = <ID>

    <PARENTHESE_OUVRANTE>
    id_attr = <ID> {listeId.add(id_attr.image);}
    (
        <VIRGULE> id_attr2 = <ID> {listeId.add(id_attr2.image);}
    )*
    <PARENTHESE_FERMANTE>

    <VALUES> <PARENTHESE_OUVRANTE> val = valeur() {listeVal.add(val);}
    (
        <VIRGULE> val = valeur() {listeVal.add(val);}
    )*
    <PARENTHESE_FERMANTE>
    <POINTVIRGULE>

    {
        if (listeId.size() == listeVal.size()){
            for(int i=0; i<listeId.size(); i++){
                tuple.setValeur(listeId.get(i),listeVal.get(i));
            }
            //Il faut récupérer la base de données
            this.getBdd().getTable().inserer(tuple);
        }
    }
}

void commandeDelete():
{
    Token t;
    ExpressionLogique exp;
    boolean hasWhere = false;
}
{
    <DELETE> <FROM> t = <ID>
    (
        <WHERE> exp = expressionLogique() {hasWhere = true;}
    )?
    <POINTVIRGULE>

    {
        if (hasWhere){
            this.getBdd().getTable().supprimer(exp);
        }
        else {
            //methode supprimer(sans param) permet de supprimer tous les tuples
            this.getBdd().getTable().supprimer();
        }
    }
}

//1. Récupérer la liste des noms des colonnes dans listeIdAvecAlias
//2. Modifier cette liste pour avoir uniquement les noms des colonnes sans les alias
//3. Transformer cette liste en liste d'colonnes pour pouvoir appeler la méthode selectionner
void commandeSelect():
{
    Token t_select;
    Collection<String> listeIdAvecAlias = new ArrayList<String>();
    Collection<String> listeIdSansAlias = new ArrayList<String>();
    Collection<Colonne> listeAttr = new ArrayList<Colonne>();
    Relation relation;
    ExpressionLogique exp;
    boolean hasEtoile = false;
    boolean hasWhere = false;
    Map<String,String> alias = new HashMap<String,String>();
}
{
    <SELECT> t_select = <ETOILE> {hasEtoile = true;}
    | t_select = <ID> {listeIdAvecAlias.add(t_select.image);}
    (
        <VIRGULE> t_select = <ID> {listeIdAvecAlias.add(t_select.image);}
    )*

    <FROM> relation = source() 
    (
        <VIRGULE> source = source() {relation = relation.produitCartesien(source);}
    )*

    (
        <WHERE> exp = expressionLogique() {hasWhere = true;}
    )?

    {
        if (!hasWhere){
            relation = relation.projeter(exp);
        }
        if (!hasEtoile){
            for(String id: listeIdAvecAlias){
                if (alias.contains(id)){
                    listeIdSansAlias.add(alias.get(id));
                }
                else {
                    listeIdSansAlias.add(id);
                }

            }
            // Pour chaque colonne de la relation sur laquelle on applique la sélection
            // On récupère les colonnes qui ont le même noms que dans la listeIdSansAlias
            for(Colonne attr: relation.getColonnes()){
                if (listeIdSansAlias.contains(attr.getIdentifiant())){
                    listeAttr.add(attr);
                }
            }

            relation = relation.selectionner(listeAttr);
        }
        relation.afficher();
    }
}

void commandeTables(): //afficher Tables
{}
{
    <TABLES> 
    {
        this.getBdd().afficherTables();
    }
}

void commandeExit():
{}
{
    t = <EXIT>
    | t = <QUIT>
    {this.getBdd().setEstOuverte(false);}
}


Colonne colonne():
{
    Type type;
    Token t;
}
{
    t = <ID> type = type()
    {return new Colonne(t.image,type);}
}

Type type():
{
    Token t;
}
{
    t = <INT> {return Type.INT;}
    | t = <VARCHAR> {return Type.VARCHAR;}
    | t = <SERIAL> {return Type.SERIAL;}
}

Valeur valeur():
{
    Token t;
}
{
    t = <NUMBER> {return new Valeur(t.image, Type.INT);}
    | t = <STRING> {return new Valeur(t.image, Type.VARCHAR);}
}

Relation source():
{
    Token t;
}
{
    t = <ID>
    (
        (<AS>)?
        t2 = <ID> {alias.put(t2,t);}
    )?

    {
        return this.getBdd().getTable(t);
    }
}

ExpressionLogique expressionLogique():
{
    ExpressionLogique exp = new ExpressionLogique();
}
{
    conditionSimple = conditionSimple() {exp.ajouterCondition(conditionSimple);}
    (
        (t = <AND> {exp.ajouterConnecteur(OperateurLogique.AND);}
        | <OR> {exp.ajouterConnecteur(OperateurLogique.OR);}
        )
        conditionSimple = conditionSimple() {exp.ajouterCondition(conditionSimple);}
    )*
    {
        return exp;
    }
}

ConditionSimple conditionSimple():
{
    Token t;
    Comparateur comparateur;
    Operande opG, opD;
    Valeur val;
}
{
    t = <ID> {opG = new OperandeColonne(t.image);}
    (t2 = <EGAL> {comparateur = Comparateur.EGAL;}
    | <SUPERIEUR> {comparateur = Comparateur.SUPERIEUR;}
    | <INFERIEUR> {comparateur = Comparateur.INFERIEUR;}
    )
    (val = valeur() {opD = new OperandeValeur(val);}
    | t3 = <ID> {opD = new OperandeColonne(t3.image);}
    )

    {
        return new ConditionSimple(opG, opD, comparateur);
    }
}
